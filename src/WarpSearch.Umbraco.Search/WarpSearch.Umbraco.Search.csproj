<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WarpSearch.Umbraco.Search</PackageId>
    <Title>WarpSearch for Umbraco Search</Title>
    <Description>Umbraco Search provider for WarpSearch (https://warpsearch.io/), the fast, affordable serverless search service. Your Umbraco content, media and member indexes live in WarpSearch instead of local Examine (Lucene) indexes on your web servers, with full-text relevance, filters, multi-select facets, sorting, culture and segment variants and protected content. No search cluster to run, one shared index for load-balanced sites, and it runs on WarpSearch's free plan.</Description>
    <PackageTags>umbraco-marketplace;umbraco;umbraco-search;search;warpsearch;full-text-search;facets</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Search.Core" Version="[18.2.0, 19.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WarpSearch.Umbraco.Search.Tests" />
  </ItemGroup>

</Project>
